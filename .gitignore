# ==========================================
# Questly - root .gitignore
# ==========================================

# ---------- Dependencies ----------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build output ----------
# Backend (TypeScript -> dist)
backend/dist/
# Frontend (Next.js)
frontend/.next/
frontend/out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel

# ---------- Environment variables (NEVER commit) ----------
.env
.env.*
**/.env
**/.env.*
# Keep the example templates
!.env.example
!**/.env.example

# ---------- Kubernetes secrets (generated by k8s/deploy.sh) ----------
k8s/*-secrets.yml
k8s/*-secrets.yaml
# Keep example templates, if you add any
!k8s/*-secrets.example.yml
!k8s/*-secrets.example.yaml

# ---------- Keys / certificates ----------
*.pem
*.key
generated/

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- IDE ----------
.vscode/
.idea/

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Legacy (old Python backend) ----------
__pycache__/
*.pyc
*.pyo
venv/
.venv/
quiz_history.db
instance/
